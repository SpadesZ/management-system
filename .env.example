# File Path: .env.example
# Timestamp: 2026-05-25T12:00:00+08:00
# Version: v0.1

APP_NAME=llm-finops-v1_1
APP_ENV=development
DEBUG=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=llm_finops
POSTGRES_USER=llm_finops
POSTGRES_PASSWORD=llm_finops
DATABASE_URL=postgresql+psycopg2://llm_finops:llm_finops@postgres:5432/llm_finops

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

MASTER_ENCRYPTION_KEY=replace-with-32-byte-urlsafe-base64-key
KMS_KEY_ID=local-master-key
KMS_KEY_VERSION=1

GATEWAY_CONNECT_TIMEOUT_SECONDS=5
GATEWAY_PROVIDER_TIMEOUT_SECONDS=60
GATEWAY_RETRY_MAX=1
GATEWAY_MOCK_PROVIDER=true

DEFAULT_SOFT_LIMIT_USD=2000
DEFAULT_HARD_LIMIT_USD=3000
COST_CURRENCY=USD

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=System Admin
DEFAULT_ADMIN_PASSWORD=ChangeThisPassword!
